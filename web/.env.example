# Public URL (no trailing slash)
NEXT_PUBLIC_APP_URL=https://on-par-waitlist.vercel.app

# Staff console password (for /staff only — not shown to guests)
STAFF_SECRET=change-me-to-a-long-random-string

# Supabase — from Supabase project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Twilio SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Branding & contact (/sms page)
VENUE_NAME=On Par Entertainment
VENUE_PHONE=937-705-6024
CONTACT_EMAIL=info@onparbar.com

# Bowling lane count at the venue (used for wait-time math)
VENUE_BOWLING_LANES=12
