# Public URL for QR codes and the iOS app (no trailing slash)
NEXT_PUBLIC_APP_URL=https://your-waitlist.vercel.app

# Staff console password
STAFF_SECRET=change-me-to-a-long-random-string

# Twilio SMS (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Optional branding in SMS
VENUE_NAME=On Par Entertainment
VENUE_PHONE=+1XXXXXXXXXX
CONTACT_EMAIL=hello@onparentertainment.com

# Production storage — add Upstash Redis from Vercel Marketplace
# Without these, waitlist data is stored in web/data/waitlist.json (local dev only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
