# Public URL for QR codes and the iOS app (no trailing slash)
NEXT_PUBLIC_APP_URL=https://on-par-waitlist.vercel.app

# Staff console password
STAFF_SECRET=change-me-to-a-long-random-string

# Twilio SMS (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Branding & contact (shown on /sms page)
VENUE_NAME=On Par Entertainment
VENUE_PHONE=937-705-6024
CONTACT_EMAIL=info@onparbar.com

# REQUIRED on Vercel — add Upstash Redis from Vercel Storage → Marketplace
# (Also accepts legacy names KV_REST_API_URL / KV_REST_API_TOKEN)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
